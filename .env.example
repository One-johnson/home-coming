# ─────────────────────────────────────────────────────────────────────────────
# Homecoming — environment template. Copy to .env.local and fill in values.
# `cp .env.example .env.local`
#
# NEVER commit real values. Secrets belong only in
# Convex (`npx convex env set ...`) and Vercel project settings — never in
# chat, email, tickets, or git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Convex (required) ────────────────────────────────────────────────────────
# From `npx convex dev` (prints the deployment URL) or the Convex dashboard.
# Public URL — safe to expose to the browser, safe as a GitHub repo secret.
NEXT_PUBLIC_CONVEX_URL=https://<deployment>.convex.cloud
# HTTP-actions URL, from the same dashboard page.
NEXT_PUBLIC_CONVEX_SITE_URL=https://<deployment>.convex.site

# ── Site ─────────────────────────────────────────────────────────────────────
# Canonical public origin (used in emails and absolute links).
NEXT_PUBLIC_SITE_URL=https://your-domain.com
SITE_URL=https://your-domain.com

# ── Payments ─────────────────────────────────────────────────────────────────
# All payment is offline (bank / MoMo receipt verification). No gateway keys
# are needed. Bank account details are configured in the admin console
# (registration_bank_details / accommodation_bank_details settings).

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
# Must also be mirrored into Convex for server-side sends:
#   npx convex env set SMTP_HOST ... (etc.)
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=your-mailbox-password
SMTP_FROM="Homecoming <noreply@yourdomain.com>"

# ── Content tooling ──────────────────────────────────────────────────────────
# Shared secret for gallery import/migration mutations. Set the SAME value in
# the Convex dashboard (Settings → Environment Variables) and here.
IMPORT_SECRET=generate-a-long-random-string
